# ==============================================================================
# Argus - Network Observability Agent Configuration
# ==============================================================================
# Copy this file to .env and adjust the values to fit your local environment.
# Note: Since Argus must run with elevated privileges (sudo/root) to load eBPF
# programs, make sure your environment variables are preserved if using sudo
# (e.g., sudo --preserve-env=PORT,ARGUS_INTERFACE or sudo -E ./argus).

# --- Agent Settings ---
# Network interface to attach the eBPF TC programs to (e.g., eth0, wlan0, lo).
# You can run `ip link` or `ifconfig` to find active interfaces on your system.
ARGUS_INTERFACE=eth0

# How often the agent reads the BPF flow map and exports metrics.
# Valid time units are "s" (seconds), "m" (minutes).
ARGUS_COLLECT_INTERVAL=5s

# TTL for process metadata cache (PID -> command, container ID).
# Shorter TTL means more accurate attribution at the cost of more /proc reads.
ARGUS_CACHE_TTL=30s

# --- Server / Prometheus Settings ---
# The port where Argus serves the dashboard and the Prometheus /metrics endpoint.
# You can specify just the port number (e.g., 9090) or a full listen address (e.g., :9090 or 127.0.0.1:9090).
PORT=9090
ARGUS_LISTEN_ADDR=:9090

# --- Logging Settings ---
# Minimum level of logs to emit. Options: trace, debug, info, warn, error.
# Use "debug" to troubleshoot, or "info" for standard production usage.
ARGUS_LOG_LEVEL=info

# Format of logs. Options:
#   "text" - human-readable logs with colors (great for local development)
#   "json" - structured JSON logs (best for production logging pipelines like ELK/Loki)
ARGUS_LOG_FORMAT=text
